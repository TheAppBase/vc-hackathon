# Every key is optional. Without them the app runs on cached/demo data.

# Nicrron (LLM, OpenAI-compatible)
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/auto
NICRRON_BASE_URL=https://api.nicrron.ai/v1

# Akta (Wokelo) external data
AKTA_API_KEY=
AKTA_BASE_URL=https://api.akta.pro/api
AKTA_USE_PAID=1

# PRISM (Block Convey) tracing
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=https://api.prism.blockconvey.com

# Roundtable shared notes
ROUNDTABLE_NOTES_ENDPOINT=
ROUNDTABLE_API_KEY=

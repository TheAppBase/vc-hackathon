# Copy to .env and fill in. Nothing here is mock data: the app shows the event notes people record and what akta.pro
# returns. A missing key turns that integration off; it never falls back to made-up data.

# Sessions (optional). Any long random string. Without it, one random key is kept in the Blob store for all instances.
SECRET_KEY=

# Firm memory: a PRIVATE Vercel Blob store. Vercel adds one of these when you connect the store to the project:
# a read-write token, or BLOB_STORE_ID (used with Vercel's OIDC token). Without either, data is written to
# runtime/store/ (local development only).
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# PRISM by Block Convey: watches and guards the agent for users in Auto mode. The API key is a secret
# (PRISM_API_KEY also works). The project id and host are not secrets and default to these values.
PRISMTRACE_API_KEY=
# PRISMTRACE_PROJECT_ID=b47943ae-502e-4b6e-baa6-389d4ca90449
# PRISMTRACE_HOST=https://api.prism.blockconvey.com

# akta.pro by Wokelo: the agents' web search. Checks the company in every note, "Source founders" and "look up X".
# Promo: DEALFLOW50 (cancel the Pro trial after the event).
AKTA_API_KEY=
# AKTA_USE_PAID=1   # set 0 to use only the free endpoints (company + industry search, no generated company lists)
# AKTA_PAID_PER_DAY=30   # paid akta.pro calls (Source founders, similar companies) per person per day

# Roundtable (optional): copies every saved note to Roundtable as a shared note. In roundtable.bot (Agents -> Connect agent)
# create a connection for this app and copy ITS MCP URL and bearer key; both are needed.
ROUNDTABLE_MCP_URL=
ROUNDTABLE_MCP_TOKEN=
# ROUNDTABLE_FOLDER=last-touch

# Nicrron (OpenAI-compatible LLM router; hackathon code BETAWORKS250): the agent's AI. It decides what each message asks
# for and writes up notes professionally. Without it, requests are matched by phrases and notes are only tidied.
NICRRON_API_KEY=
# NICRRON_MODEL=anthropic/claude-sonnet-5-5      # writes up notes
# NICRRON_FAST_MODEL=anthropic/claude-haiku-5-5  # decides what each message asks for
# NICRRON_BASE_URL=https://api.nicrron.ai/v1

# Copy to .env and fill in. Every key is optional: missing keys fall back to labelled demo data.

# Nicrron (OpenAI-compatible). Hackathon code: BETAWORKS250
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/auto
# NICRRON_BASE_URL=https://api.nicrron.ai/v1

# Akta by Wokelo. Promo: DEALFLOW50 (cancel the Pro trial after the event)
AKTA_API_KEY=
# AKTA_USE_PAID=1   # set 0 to use only the free endpoints (company + industry search)

# PRISM by Block Convey. Code: DEALFLOW. Project id is in the PRISM dashboard.
PRISMTRACE_API_KEY=          # PRISM_API_KEY also works
PRISMTRACE_PROJECT_ID=       # PRISM_PROJECT_ID also works

# Roundtable: in roundtable.bot (Agents -> Connect agent) create a connection for this app and copy ITS MCP URL and
# bearer key (never a personal assistant's key). The URL alone is rejected (401); both are needed.
ROUNDTABLE_MCP_URL=https://roundtable.bot/mcp
ROUNDTABLE_MCP_TOKEN=
# ROUNDTABLE_FOLDER=last-touch

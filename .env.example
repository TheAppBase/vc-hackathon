# Copy to .env and fill in. Nothing here is mock data: the app only shows what is in your Google account and firm memory.

# Sessions. Any long random string; keep it stable across deploys.
SECRET_KEY=

# Firm memory: a PRIVATE Vercel Blob store. Vercel adds this when you connect the store to the project.
# Without it, data is written to runtime/store/ (local development only).
BLOB_READ_WRITE_TOKEN=

# Google (Gmail, Google Calendar, Google Chat). OAuth client of type "Web application" in Google Cloud.
# Enable the Gmail API, Google Calendar API and Google Chat API (Chat also needs a Chat app configured in that project).
# Authorized redirect URI: https://<your-domain>/auth/google/callback (and http://127.0.0.1:5000/auth/google/callback locally)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # only if the computed one is wrong behind a proxy

# PRISM by Block Convey: guards the agent in Auto mode (reviews every write) and traces LLM calls. Project id is in the PRISM dashboard.
PRISM_API_KEY=
PRISM_PROJECT_ID=   # required too: the project id from the PRISM dashboard

# Nicrron (OpenAI-compatible LLM), optional: extracts founder details from emails. Without it, keyword rules do it.
NICRRON_API_KEY=
NICRRON_MODEL=nicrron/auto
# NICRRON_BASE_URL=https://api.nicrron.ai/v1
